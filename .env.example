# Copy to .env (development, database echo_dev).
# Copy to .env.test too, and change DB_NAME to echo_test (tests only).
# Both files are gitignored. Values below are for local development only.

# Read by docker compose (the Postgres superuser)
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_local_password

# Read by the API
DB_HOST=localhost
DB_PORT=5432
DB_USER=echo
DB_PASSWORD=echo_local_password
DB_NAME=echo_dev

# Dev seed (npm run seed). Local development only; the seed refuses NODE_ENV=production.
ADMIN_EMAIL=admin@echo.local
ADMIN_PASSWORD=password
SEED_USER_PASSWORD=password123

# Password given to accounts the admin creates or resets (min 8 chars; the user must
# change it at first login). Required. Use something non-guessable outside local development.
DEFAULT_USER_PASSWORD=changeme123

# Auth. JWT_SECRET is required; use a long random value outside local development.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=15m
