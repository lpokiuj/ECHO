# Copy to .env (development, database echo_dev).
# Copy to .env.test too, and change DB_NAME to echo_test (tests only).
# Both files are gitignored. Values below are for local development only.

# Read by docker compose (the Postgres superuser)
POSTGRES_USER=echo
POSTGRES_PASSWORD=echo_local_password

# Read by the API
DB_HOST=localhost
DB_PORT=5432
DB_USER=echo
DB_PASSWORD=echo_local_password
DB_NAME=echo_dev

# Dev seed (npm run seed). Local development only; the seed refuses NODE_ENV=production.
ADMIN_EMAIL=admin@echo.local
ADMIN_PASSWORD=password
SEED_USER_PASSWORD=password123
# Password given to accounts the admin creates or resets (min 8 chars; users may change
# it voluntarily). Required. Use something non-guessable outside local development.
DEFAULT_USER_PASSWORD=changeme123

# Auth. JWT_SECRET is required, min 32 characters; use a long random value (openssl rand -hex 32) outside local development.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=15m
# Failed-or-not login attempts allowed per IP and email in 15 minutes (optional, default 5)
# LOGIN_RATE_LIMIT=5
