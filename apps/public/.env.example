# Dev proxy target for /api (read in vite.config.ts only; never exposed to the browser)
API_PROXY_TARGET=http://localhost:3000

# Browser-exposed (VITE_*): never put a secret here.
# Where the footer link "Portal Relawan" points. Default when unset: /volunteer-portal/
# In dev, .env.development sets it to the portal's dev server.
VITE_PORTAL_URL=/volunteer-portal/

# Playwright (browser tests)
# Origin of the public dev server (apps/web uses E2E_BASE_URL, so this one has its own name)
E2E_PUBLIC_BASE_URL=http://localhost:5174
# Same E2E admin as apps/web; the global setup logs in once per run to delete e2e- submissions
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
