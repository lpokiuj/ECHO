# Dev proxy target for /api (read in vite.config.ts only; never exposed to the browser)
API_PROXY_TARGET=http://localhost:3000

# Playwright (browser tests)
E2E_BASE_URL=http://localhost:5173
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Initial password of users the admin creates (same value as the API's DEFAULT_USER_PASSWORD). Needed by e2e/auth.spec.ts
E2E_USER_PASSWORD=
